{
  "title": "Snow Squall Live Object",
  "type": "object",
  "required": [
    "track_id",
    "timestamp",
    "geometry",
    "probability_30min",
    "probability_trend",
    "data_quality"
  ],
  "properties": {
    "track_id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "Polygon"},
        "coordinates": {"type": "array"}
      }
    },
    "probability_15min": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "probability_30min": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "probability_45min": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "probability_60min": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "probability_trend": {"type": "string", "enum": ["rising", "steady", "falling", "unknown"]},
    "age_min": {"type": ["number", "null"]},
    "track_first_scan_utc": {"type": ["string", "null"], "format": "date-time"},
    "track_age_min": {"type": ["number", "null"]},
    "track_age_scans": {"type": ["integer", "null"], "minimum": 1},
    "track_missed_scans": {"type": ["integer", "null"], "minimum": 0},
    "track_status": {"type": ["string", "null"], "enum": ["active", "missed", "ended", null]},
    "track_association_status": {"type": ["string", "null"]},
    "motion_dir_deg": {"type": ["number", "null"]},
    "motion_speed_kt": {"type": ["number", "null"]},
    "drivers": {"type": "array", "items": {"type": "string"}},
    "data_quality": {"type": "string", "enum": ["good", "degraded", "poor"]},
    "model_version": {"type": "string"}
  }
}
